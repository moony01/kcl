{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mearrow-web-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "mearrow-web-preview"
    },
    "production": {
      "name": "mearrow-web"
    }
  }
}
